# Fastfile for NetPulse iOS
default_platform(:ios)

platform :ios do
  desc "Сборка и выгрузка сборки в Apple TestFlight"
  lane :beta do
    # Аутентификация через App Store Connect API Key
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: false
    )

    # Инкремент номера билда
    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s,
      xcodeproj: "NetPulse.xcodeproj"
    )

    # Сборка приложения
    build_app(
      project: "NetPulse.xcodeproj",
      scheme: "NetPulse",
      configuration: "Release",
      export_method: "app-store",
      export_options: "ExportOptions.plist",
      output_directory: "./build",
      output_name: "NetPulse.ipa",
      clean: true
    )

    # Выгрузка в TestFlight
    upload_to_testflight(
      api_key: api_key,
      ipa: "./build/NetPulse.ipa",
      skip_waiting_for_build_processing: true,
      changelog: "Обновление NetPulse: Мониторинг сети в реальном времени, Swift 6.0, джиттер RFC 3550 и Speedtest."
    )
  end
end
